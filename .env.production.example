APP_NAME="Time & Attendance Tracking"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://attendance.example.com
APP_TIMEZONE=Africa/Johannesburg
APP_KEY=replace-with-at-least-64-random-characters
APP_VERSION=1.0.4
AGENT_VERSION=1.4.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
SETUP_TOKEN=
DB_SSL_CA=
DB_SSL_VERIFY=false

SESSION_NAME=attendance_session
SESSION_LIFETIME=60
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

API_RATE_LIMIT_ATTEMPTS=120
API_RATE_LIMIT_WINDOW=60
